2e:["$","div",null,{"className":"space-y-6 mb-12","children":[["$","div",null,{"className":"bg-gray-50 p-6 rounded","children":[["$","h3",null,{"className":"text-xl font-bold text-notary-navy mb-3","children":"How long does it take to become a notary in California?"}],["$","p",null,{"className":"text-gray-700","children":"6-8 weeks total from starting your education course to receiving your commission. This includes 1 week for the course, 1-2 weeks studying and scheduling, taking the exam, 2-4 weeks for background check and processing, and 1 week to file your oath and bond."}]]}],["$","div",null,{"className":"bg-gray-50 p-6 rounded","children":[["$","h3",null,{"className":"text-xl font-bold text-notary-navy mb-3","children":"How much does it cost to become a notary in California?"}],["$","p",null,{"className":"text-gray-700","children":"$$400-600 total. This includes: 6-hour course ($50-150), exam + application fee ($40), Live Scan fingerprinting ($70-100), notary bond ($40-60), stamp ($25-40), journal ($15-25), and optional E&O insurance ($50-150/year)."}]]}],["$","div",null,{"className":"bg-gray-50 p-6 rounded","children":[["$","h3",null,{"className":"text-xl font-bold text-notary-navy mb-3","children":"What are the requirements to become a notary in California?"}],["$","p",null,{"className":"text-gray-700","children":"You must be: (1) 18 years or older, (2) a legal California resident, (3) pass a criminal background check, (4) complete a 6-hour approved education course, and (5) pass the state exam with 70% or higher."}]]}],["$","div",null,{"className":"bg-gray-50 p-6 rounded","children":[["$","h3",null,{"className":"text-xl font-bold text-notary-navy mb-3","children":"How hard is the California notary exam?"}],["$","p",null,{"className":"text-gray-700","children":"Moderately challenging. The pass rate is approximately 65%, meaning 35% of test-takers fail. You need to score 70% (42 out of 60 questions correct). With 1-2 weeks of studying using the Notary Public Handbook and practice exams, most people pass on their first attempt."}]]}],["$","div",null,{"className":"bg-gray-50 p-6 rounded","children":[["$","h3",null,{"className":"text-xl font-bold text-notary-navy mb-3","children":"Can I become a notary if I have a felony?"}],["$","p",null,{"className":"text-gray-700","children":"No. Any felony conviction disqualifies you from becoming a California notary public. Convictions involving dishonesty, fraud, deceit, or moral turpitude also disqualify. Minor misdemeanors and traffic violations generally do not disqualify you."}]]}],["$","div",null,{"className":"bg-gray-50 p-6 rounded","children":[["$","h3",null,{"className":"text-xl font-bold text-notary-navy mb-3","children":"Do I need to be a US citizen to become a California notary?"}],["$","p",null,{"className":"text-gray-700","children":"No, you do not need to be a U.S. citizen. You must be a legal resident of California, but citizenship is not required."}]]}],["$","div",null,{"className":"bg-gray-50 p-6 rounded","children":[["$","h3",null,{"className":"text-xl font-bold text-notary-navy mb-3","children":"How much can I make as a California notary?"}],["$","p",null,{"className":"text-gray-700","children":"Part-time mobile notaries in California often earn around $1,500-3,000/month. Full-time schedules may go higher, especially when travel fees and more specialized work are part of the mix."}]]}],["$","div",null,{"className":"bg-gray-50 p-6 rounded","children":[["$","h3",null,{"className":"text-xl font-bold text-notary-navy mb-3","children":"How long is a California notary commission valid?"}],["$","p",null,{"className":"text-gray-700","children":"4 years. Your commission start and expiration dates are printed on your certificate. You can begin the renewal process up to 6 months before expiration."}]]}],"$L39","$L3a","$L3b","$L3c","$L3d","$L3e","$L3f"]}]
