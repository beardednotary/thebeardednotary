2b:["$","h2",null,{"className":"text-3xl font-bold text-notary-navy mt-12 mb-6","children":"Common Mistakes to Avoid"}]
2c:["$","div",null,{"className":"space-y-4 mb-8","children":[["$","div",null,{"className":"bg-red-50 border-l-4 border-red-500 p-6","children":[["$","h4",null,{"className":"font-bold text-red-900 mb-2","children":"❌ Missing the 30-Day Filing Deadline"}],["$","p",null,{"className":"text-gray-700","children":"This is the #1 mistake. File your oath and bond IMMEDIATELY when you receive your commission packet. Don't wait until day 29. If you miss this deadline, your commission is void and you start over from scratch."}]]}],["$","div",null,{"className":"bg-red-50 border-l-4 border-red-500 p-6","children":[["$","h4",null,{"className":"font-bold text-red-900 mb-2","children":"❌ Buying Unauthorized Stamps"}],["$","p",null,{"className":"text-gray-700","children":"Only purchase stamps from manufacturers on the Secretary of State's authorized list (included in your commission packet). Amazon stamps are NOT acceptable and using one can result in discipline."}]]}],["$","div",null,{"className":"bg-red-50 border-l-4 border-red-500 p-6","children":[["$","h4",null,{"className":"font-bold text-red-900 mb-2","children":"❌ Not Getting E&O Insurance"}],["$","p",null,{"className":"text-gray-700","children":"Your bond protects the public, not you. One lawsuit could wipe out your personal savings. Get E&O insurance ($50-150/year) before your first notarization."}]]}],["$","div",null,{"className":"bg-red-50 border-l-4 border-red-500 p-6","children":[["$","h4",null,{"className":"font-bold text-red-900 mb-2","children":"❌ Not Studying Enough for the Exam"}],["$","p",null,{"className":"text-gray-700","children":"35% of test-takers fail. Don't be overconfident. Study for 1-2 weeks, take practice exams, and aim for 80%+ on practice tests before taking the real exam."}]]}],["$","div",null,{"className":"bg-red-50 border-l-4 border-red-500 p-6","children":[["$","h4",null,{"className":"font-bold text-red-900 mb-2","children":"❌ Notarizing for Family Without Proper Procedure"}],["$","p",null,{"className":"text-gray-700","children":"Just because they're family doesn't mean you can skip steps. You CANNOT notarize for anyone with a financial interest in the document. Follow all ID verification and journal requirements - every time."}]]}]]}]
