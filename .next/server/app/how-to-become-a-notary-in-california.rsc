28:["$","div",null,{"className":"bg-gray-50 p-6 mb-8 rounded","children":[["$","h3",null,{"className":"text-xl font-bold text-notary-navy mb-4","children":"Renewal Process (Shorter than Initial)"}],["$","ol",null,{"className":"list-decimal pl-6 text-gray-700 space-y-3","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Complete 3-hour refresher course"}]," (instead of 6 hours) - must be done before your current commission expires"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Take and pass the exam"}]," - same 60-question test, 70% to pass"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Complete Live Scan"}]," - background check required again"]}],["$","li",null,{"children":["$","strong",null,{"children":"Receive new commission packet"}]}],["$","li",null,{"children":[["$","strong",null,{"children":"Purchase new bond and supplies"}]," (new stamp with updated expiration date)"]}],["$","li",null,{"children":[["$","strong",null,{"children":"File oath and bond"}]," - same 30-day deadline"]}]]}]]}]
