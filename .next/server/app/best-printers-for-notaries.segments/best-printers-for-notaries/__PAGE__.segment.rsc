}],["$","div",null,{"className":"border-l-4 border-notary-gold pl-6","children":[["$","p",null,{"className":"font-bold text-notary-navy mb-2","children":"Do you need to print on-site at signings?"}],["$","p",null,{"className":"text-gray-700 mb-2","children":[["$","strong",null,{"children":"YES →"}]," Add HP OfficeJet 250 as backup/portable"]}],["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"NO →"}]," Just get a good desktop laser"]}]]}],["$","div",null,{"className":"border-l-4 border-notary-gold pl-6","children":[["$","p",null,{"className":"font-bold text-notary-navy mb-2","children":"What's your budget?"}],["$","p",null,{"className":"text-gray-700 mb-2","children":[["$","strong",null,{"children":"Under $250 →"}]," Brother HL-L2480DW (single-tray)"]}],["$","p",null,{"className":"text-gray-700 mb-2","children":[["$","strong",null,{"children":"$$400-500 →"}]," Brother HL-L5210DWT (the standard)"]}],["$","p",null,{"className":"text-gray-700 mb-2","children":[["$","strong",null,{"children":"$$500-700 →"}]," Brother HL-L6210DWT or HL-L6310DW"]}],["$","p",null,{"className":"text-gray-700","children":[["$","strong",null,{"children":"$$1,000+ →"}]," HP M632fht (if you need all-in-one)"]}]]}]]}]]}]
3c:["$","h2",null,{"className":"text-3xl font-bold text-notary-navy mt-12 mb-6","children":"Printer Maintenance Tips for Long Life"}]
3d:["$","div",null,{"className":"bg-gray-50 p-6 mb-8 rounded","children":["$","ol",null,{"className":"list-decimal pl-6 text-gray-700 space-y-3","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Use high-quality paper"}]," - Cheap paper causes jams. Use 24lb or 28lb copy paper from name brands."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Clean the printer monthly"}]," - Run a cleaning cycle and wipe down the rollers with a damp cloth."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Replace toner before it's empty"}]," - Running a cartridge dry can damage the drum. Replace when you hit 10% remaining."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Keep firmware updated"}]," - Brother and HP release firmware updates that fix bugs and improve performance."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Don't overfill paper trays"}]," - Leave 1/2\" of space at the top to prevent jams."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Print regularly"}]," - Printers that sit unused for weeks develop issues. Print at least once per week even if it's just a test page."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Keep it dust-free"}]," - Dust causes paper feed issues. Cover your printer when not in use or keep it in a clean area."]}]]}]}]
3e:["$","div",null,{"className":"bg-gradient-to-r from-notary-navy to-blue-900 text-white p-8 my-12 rounded text-center","children":[["$","h3",null,{"className":"text-2xl font-bold mb-4","children":"What to Read Next"}],["$","p",null,{"className":"text-lg mb-6","children":"A great printer is just the start. Check out our complete mobile notary supplies guide for everything else you need."}],["$","$L2",null,{"href":"/mobile-notary-supplies","className":"inline-block bg-notary-gold px-8 py-4 font-bold text-lg transition-opacity hover:opacity-90 rounded","style":{"color":"#1a2332"},"children":"See Complete Supplies Checklist"}]]}]
