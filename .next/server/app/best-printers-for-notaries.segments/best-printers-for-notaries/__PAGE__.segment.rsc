38:["$","div",null,{"className":"space-y-6 mb-12","children":[["$","div",null,{"className":"bg-red-50 border-l-4 border-red-500 p-6","children":[["$","h4",null,{"className":"font-bold text-red-900 mb-2","children":"❌ Buying an Inkjet for Loan Signings"}],["$","p",null,{"className":"text-gray-700","children":"Inkjets are 3-4x more expensive per page and 4x slower. A 200-page package costs $16 in ink vs $5 in toner, and takes 20 minutes vs 5 minutes. Don't do it."}]]}],["$","div",null,{"className":"bg-red-50 border-l-4 border-red-500 p-6","children":[["$","h4",null,{"className":"font-bold text-red-900 mb-2","children":"❌ Skipping the Second Tray to Save Money"}],["$","p",null,{"className":"text-gray-700","children":"You'll spend 10+ minutes per signing manually sorting paper. That's time you could spend doing another signing. The dual-tray upgrade pays for itself in 2-3 months."}]]}],["$","div",null,{"className":"bg-red-50 border-l-4 border-red-500 p-6","children":[["$","h4",null,{"className":"font-bold text-red-900 mb-2","children":"❌ Not Checking Monthly Duty Cycle"}],["$","p",null,{"className":"text-gray-700","children":"Cheap printers rated for 1,000 pages/month will break if you print 5,000. Check the duty cycle and make sure it matches your volume."}]]}],["$","div",null,{"className":"bg-red-50 border-l-4 border-red-500 p-6","children":[["$","h4",null,{"className":"font-bold text-red-900 mb-2","children":"❌ Buying Third-Party Toner to Save $20"}],["$","p",null,{"className":"text-gray-700","children":"Third-party toner causes print quality issues, jams, and can void your warranty. Stick with OEM (Brother, HP) toner cartridges."}]]}],["$","div",null,{"className":"bg-red-50 border-l-4 border-red-500 p-6","children":[["$","h4",null,{"className":"font-bold text-red-900 mb-2","children":"❌ Not Having a Backup Printer"}],["$","p",null,{"className":"text-gray-700","children":"Your printer will die the morning of your biggest signing. Have a backup plan (second printer, UPS/FedEx location nearby, or friend with a printer)."}]]}]]}]
