e:["$","div",null,{"className":"mb-12 border-b pb-8","children":[["$","h2",null,{"className":"text-2xl font-bold text-notary-navy mb-4","children":"Portable Document Scanner"}],["$","p",null,{"className":"text-gray-700 mb-4","children":"A portable document scanner is a very handy tool to have, ESPECIALLY as a loan signing agent. During loan signings, two copies are produced: the borrower copy and the lender copy. After completion of signing the borrower receives their copy and you send the lender's copy back to them via mail or fax."}],["$","p",null,{"className":"text-gray-700 mb-4","children":"A mobile document scanner can provide an on-demand digital backup for both sides of the transaction. It can serve as an important \"add-on\" service for your mobile notary business."}],["$","p",null,{"className":"text-gray-700 mb-4","children":["Want help choosing one? Read our ",["$","$L2",null,{"href":"/best-scanners-for-notaries","className":"text-notary-gold hover:underline","children":"best scanner guide for notaries"}]," for the top portable and office-friendly picks."]}],["$","a",null,{"href":"https://amzn.to/4j1Pntw","target":"_blank","rel":"noopener noreferrer","className":"inline-block bg-notary-navy text-white px-6 py-3 font-semibold hover:bg-opacity-90 transition","children":"Shop Scanners"}]]}]
